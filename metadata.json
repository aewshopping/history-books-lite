{
  "plugins": {
    "datasette-auth-tokens": {
      "tokens": [
        {
          "token": "password1",
          "actor": {
            "id": "token-user"
          }
        }
      ],
      "param": "_auth_token"
    },
    "datasette-ip-rate-limit": {
      "header": "X-Forwarded-For",
      "max_keys": 10000,
      "exempt_paths": [
        "/-/static/*"
      ],
      "rules": [
        {
          "name": "global",
          "paths": [
            "/*"
          ],
          "window_seconds": 60,
          "max_requests": 120,
          "block_seconds": 300
        }
      ]
    }
  },
  "allow_sql": {
    "id": "token-user"
  }
}
